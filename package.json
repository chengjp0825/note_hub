{
  "name": "vitepress-datasheet-blog",
  "version": "1.0.0",
  "type": "module",
  "description": "architecture and datasheet notes",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "predev": "npm run build:question-bank",
    "prebuild": "npm run build:question-bank",
    "dev": "vitepress dev docs",
    "build": "vitepress build docs",
    "build:question-bank": "node scripts/build-question-bank.mjs",
    "check:staged-doc-links": "node scripts/check-staged-doc-links.mjs",
    "check:build-output": "node scripts/check-build-output.mjs",
    "check:deadlinks": "vitepress build docs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "check": "npm run typecheck && npm run build && npm run check:build-output",
    "preview": "vitepress preview docs",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@tanstack/vue-virtual": "^3.13.39",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.1",
    "markdown-it-mathjax3": "^4.3.2",
    "minisearch": "^7.2.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "medium-zoom": "^1.1.0",
    "mermaid": "^11.17.2",
    "sass": "^1.80.0",
    "sass-embedded": "^1.80.0",
    "vitepress": "^1.0.0",
    "typescript": "6.0.3",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.13"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12",
    "dompurify": "3.4.17",
